# Copy to .env.local for local development, and add the same names in
# Vercel > Project > Settings > Environment Variables for the live site.
# Every service is optional: the shop runs on sample data until keys are set.

# Public address of the site (used in emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project settings > API) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys, use test keys first) ------------------
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the dashboard
STRIPE_WEBHOOK_SECRET=

# --- Resend (API keys; verify your sending domain first) -----------------
RESEND_API_KEY=
# Must use your verified domain, e.g. Kokolina <hello@kokolina.com>
EMAIL_FROM=
# Optional: where new order alerts go
ADMIN_NOTIFY_EMAIL=

# --- Sentry (Project settings > Client keys) ------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional, for readable stack traces (source map upload during build)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- PostHog (Project settings) -------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud by default; use https://us.i.posthog.com and https://us.posthog.com for US
NEXT_PUBLIC_POSTHOG_INGEST_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
